---
import { Layout } from "#/app/layout";
import { homePage, HomeHero } from "#/site/home";
import { LANGUAGES, type Language } from "#/features/i18n";
import { Awards } from "#/site/company";
import { CollectionCards } from "#/site/collections";

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout offset={false} lang={lang} title={homePage[lang].title} description={homePage[lang].description}>
  <HomeHero lang={lang} />
  <CollectionCards lang={lang} />
  <Awards lang={lang} />
</Layout>
