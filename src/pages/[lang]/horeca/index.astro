---
import { Layout } from "#/app/layout";
import { horecaPage, SegmentsGrid } from "#/site/segments";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout offset={false} lang={lang} path="/horeca" title={horecaPage[lang].title} description={horecaPage[lang].description}>
  <h1 class="sr-only">{horecaPage[lang].h1}</h1>
  <SegmentsGrid lang={lang} />
</Layout>
