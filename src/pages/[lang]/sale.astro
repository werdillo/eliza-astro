---
import { Layout } from "#/app/layout";
import { salePage, SaleGrid } from "#/site/products";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/sale" title={salePage[lang].title} description={salePage[lang].description}>
  <h1 class="sr-only">{salePage[lang].h1}</h1>
  <SaleGrid lang={lang} />
</Layout>
