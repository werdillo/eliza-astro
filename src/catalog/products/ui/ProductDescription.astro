---
import { fileUrl } from "#/core/pocketbase";
import type { Language } from "#/features/i18n";
import type { Product } from "#/catalog/shared/product";
import { H3, P1 } from "#/components/typography";
import { translations } from "../data";

export interface Props {
  item: Product;
  lang: Language;
}

const { item, lang } = Astro.props;
const t = translations[lang];
const html = item[`description_${lang}`] as string | undefined;
---

{
  html && (
    <div class="product-card">
      <H3 as="h2">{t.description}</H3>
      {/* Descriptions are HTML written in the CMS by the site owner. */}
      <div class="text-p1" set:html={html} />
      {item.schema && (
        <a href={fileUrl(item, item.schema)} target="_blank" rel="noopener noreferrer" class="product-button self-start">
          <P1 as="span">{t.dimensions}</P1>
        </a>
      )}
    </div>
  )
}
