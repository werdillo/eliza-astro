---
import { Image } from "astro:assets";
import { fileUrl } from "#/core/pocketbase";
import type { Language } from "#/features/i18n";
import type { Product } from "#/site/shared/product";
import { H2, P1, P2 } from "#/components/typography";
import { mattressFields, translations } from "../../data";
import { productImage } from "../../routes";

export interface Props {
  item: Product;
  lang: Language;
}

const { item, lang } = Astro.props;
const t = translations[lang];
const src = productImage(item, "mattress", lang);
const file = item[`file_${lang}`] as string | undefined;
const fieldLabel = mattressFields[String(item.field ?? "")]?.[lang];
---

<div class="mat-page">
  <div class="mat-poster-box">
    {src && <Image src={src} alt={item.name} width={1400} height={2100} fit="contain" widths={[640, 1024, 1400]} sizes="(max-width: 900px) 100vw, 60vw" format="webp" quality={82} class="mat-poster" loading="eager" fetchpriority="high" />}
  </div>

  <aside class="mat-aside">
    <div class="flex flex-col gap-[var(--space-4)]">
      {fieldLabel && <P2 as="p" class="m-0 text-price-old">{fieldLabel}</P2>}
      <H2 as="h1" class="m-0">{item.name}</H2>
    </div>
    <div class="mat-actions">
      <a href="mailto:teika@eliza-k.lv" class="mat-action mat-action-primary">
        <P1 as="span">{t.sendEmail}</P1>
      </a>
      {
        file && (
          <a href={fileUrl(item, file)} target="_blank" rel="noopener noreferrer" class="mat-action mat-action-outline">
            <P1 as="span">{t.dimensions}</P1>
          </a>
        )
      }
      <a href={`/files/cleaning-mattresses-${lang}.pdf`} target="_blank" rel="noopener noreferrer" class="mat-action mat-action-outline">
        <P1 as="span">{t.cleaning}</P1>
      </a>
    </div>
  </aside>
</div>
