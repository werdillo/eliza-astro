---
import { Layout } from "#/app/layout";
import { catalogsPage, CatalogsList } from "#/site/catalogs";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/catalogs" title={catalogsPage[lang].title} description={catalogsPage[lang].description}>
  <CatalogsList lang={lang} />
</Layout>
