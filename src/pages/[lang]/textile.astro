---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { TextileItems } from "#/site/materials";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/textile" title={pages.textile[lang].title} description={pages.textile[lang].description}>
  <h1 class="sr-only">{pages.textile[lang].h1}</h1>
  <TextileItems lang={lang} />
</Layout>
