---
import { Image } from "astro:assets";
import { Slider } from "#/components/slider";
import type { Language } from "#/features/i18n";
import { awards } from "../data";

const { lang } = Astro.props as { lang: Language };
const label: Record<Language, string> = { lv: "Eliza-K apbalvojums", en: "Eliza-K award", ru: "Награда Eliza-K" };
---

<div class="flex items-center justify-center w-full my-[var(--space-30)] gap-[var(--space-40)_var(--space-20)] flex-wrap max-768:p-0">
    <Slider id="awards-swiper" pagination="false" speed="500" loop="true" autoplayDelay="3000">
        {
            awards.map((image) => (
                <swiper-slide>
                    <div class="flex justify-center">
                        <Image src={image} alt={label[lang]} width={320} widths={[160, 320]} sizes="(max-width: 768px) 110px, 160px" format="webp" quality={80} class="max-w-[160px] h-auto w-full max-768:w-full max-768:max-w-[110px]" />
                    </div>
                </swiper-slide>
            ))
        }
    </Slider>
</div>

<script>
    // Configure breakpoints after DOM is ready
    document.addEventListener("DOMContentLoaded", () => {
        const swiperEl = document.querySelector<HTMLElement & { breakpoints?: unknown }>("#awards-swiper");
        if (swiperEl) {
            const breakpoints = {
                1400: { slidesPerView: 8, navigation: true },
                1200: { slidesPerView: 6, navigation: true },
                768: { slidesPerView: 4 },
                500: { slidesPerView: 3 },
                300: { slidesPerView: 3 },
            };

            Object.assign(swiperEl, {
                breakpoints: breakpoints,
            });
        }
    });
</script>
