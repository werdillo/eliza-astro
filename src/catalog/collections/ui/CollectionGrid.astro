---
import { fileUrl } from "#/core/pocketbase";
import { productLink } from "#/catalog/products";
import type { Product } from "#/catalog/shared/product";
import { typeLabel } from "#/catalog/shared/typeLabels";
import type { Language } from "#/features/i18n";
import { LandingTile } from "#/components/landing-tile";
import { H3, P2 } from "#/components/typography";
import { getBrandProducts } from "../api";

export interface Props {
  brand: string;
  lang: Language;
}

const { brand, lang } = Astro.props;
const items = await getBrandProducts(brand);

/** The products of the brand, grouped by type, each with the link to its page. */
const groups = new Map<string, { item: Product; href: string }[]>();
for (const item of items) {
  const key = item.type || "other";
  const group = groups.get(key) ?? [];
  group.push({ item, href: await productLink(lang, "def", item.id) });
  groups.set(key, group);
}
---

{
  [...groups].map(([type, cards]) => (
    <section class="w-full">
      <H3 as="h2" class="list-title">{typeLabel(lang, type)}</H3>
      <div class="product-list">
        {cards.map(({ item, href }) => (
          <LandingTile href={href} src={fileUrl(item, item.images[0])} alt={item.name}>
            <P2 as="p" class="landing-name">{item.name.toUpperCase()}</P2>
          </LandingTile>
        ))}
      </div>
    </section>
  ))
}
