---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { ComingSoon } from "#/features/coming-soon";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const crumbs = [{ name: pages.horeca[lang].h1 ?? "", path: "/horeca" }, { name: pages.cafe[lang].h1 ?? "", path: "/horeca/cafe" }];
---

<Layout lang={lang} crumbs={crumbs} path="/horeca/cafe" title={pages.cafe[lang].title} description={pages.cafe[lang].description} offset={false}>
  <ComingSoon lang={lang} />
</Layout>
