---
import { fileUrl } from "#/core/pocketbase";
import type { Language } from "#/features/i18n";
import type { Product, ProductKind } from "#/catalog/shared/product";
import { H2, H3, P1 } from "#/components/typography";
import { translations } from "../data";

export interface Props {
  item: Product;
  kind: ProductKind;
  lang: Language;
}

const { item, kind, lang } = Astro.props;
const t = translations[lang];
const mattressFile = kind === "mattress" ? (item[`file_${lang}`] as string | undefined) : undefined;
---

<div class="product-right">
  <H2 as="h1">{item.name}</H2>

  {
    kind === "sale" && (item.price || item.oldPrice) && (
      <div class="product-price-row">
        {item.price && <H3 as="span" class="product-price">€{item.price}</H3>}
        {item.oldPrice && <P1 as="span" class="product-old-price">€{item.oldPrice}</P1>}
      </div>
    )
  }

  {
    mattressFile && (
      <div class="flex flex-wrap gap-[var(--space-12)]">
        <a href={fileUrl(item, mattressFile)} target="_blank" rel="noopener noreferrer" class="product-button">
          <P1 as="span">{t.dimensions}</P1>
        </a>
        <a href={`/files/cleaning-mattresses-${lang}.pdf`} target="_blank" rel="noopener noreferrer" class="product-button">
          <P1 as="span">{t.cleaning}</P1>
        </a>
      </div>
    )
  }

  <a href="mailto:teika@eliza-k.lv" class="product-button-xl">
    <P1 as="span">{t.sendEmail}</P1>
  </a>
</div>
