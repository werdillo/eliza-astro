---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { CatalogsList } from "#/catalog/catalogs";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/catalogs" title={pages.catalogs[lang].title} description={pages.catalogs[lang].description}>
  <CatalogsList lang={lang} />
</Layout>
