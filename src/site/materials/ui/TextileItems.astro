---
import { Image } from "astro:assets";
import { fileUrl } from "#/core/pocketbase";
import type { Language } from "#/features/i18n";
import { H3, P2 } from "#/components/typography";
import { getTextileItems } from "../api";

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const items = await getTextileItems();
// Every photo of every fabric is one tile of a single grid; the fabric's heading is on its first photo.
const tiles = items.flatMap((item) =>
  [1, 2, 3, 4]
    .filter((n) => item[`image${n}`])
    .map((n, index) => ({ item, n, heading: index === 0 ? "h2" : "span" })),
);
---

<div class="textile-grid">
  {
    tiles.map(({ item, n, heading }) => (
      <div class="min-w-0">
        <div class="textile-item">
          <Image class="textile-img" src={fileUrl(item, item[`image${n}`])} alt={item[`title_${lang}`] || item.name} width={800} height={800} fit="cover" widths={[400, 800]} sizes="(max-width: 600px) 50vw, (max-width: 1200px) 33vw, 25vw" format="webp" quality={78} />
          <div class="textile-caption">
            <H3 as={heading} class="m-0">{item[`title_${lang}`]}</H3>
            {item[`text${n}`] && <P2 as="span">{item[`text${n}`]}</P2>}
          </div>
        </div>
      </div>
    ))
  }
</div>
