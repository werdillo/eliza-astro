---
import { fileUrl } from "#/core/pocketbase";
import { getGallery } from "../api";

const gallery = await getGallery();
const images: string[] = gallery?.image ?? [];

---

<div class="gallery-grid">
  {
    gallery &&
      images.map((image) => (
      <img src={fileUrl(gallery, image)} alt="Gallery image" width="1600" height="1000" loading="lazy" class="gallery-img" />
    ))
  }
</div>
