---
import type { Language } from "#/features/i18n";
import type { Product, ProductKind } from "#/catalog/shared/product";
import { H3, P1 } from "#/components/typography";
import { translations } from "../data";

export interface Props {
  item: Product;
  kind: ProductKind;
  lang: Language;
}

const { item, kind, lang } = Astro.props;
const t = translations[lang];
const fabrics = [
  { src: "/textile/matrix.jpeg", alt: "Matrix" },
  { src: "/textile/falcone.jpeg", alt: "Falcone" },
  { src: "/textile/salvador.jpeg", alt: "Salvador" },
];
---

{
  kind !== "mattress" && (item[`description_${lang}`] as string | undefined) && (
    <div class="product-card">
      <H3 as="h2">{t.fabrics}</H3>
      <div class="product-textile">
        {fabrics.map((fabric) => (
          <img src={fabric.src} alt={fabric.alt} width="1100" height="1100" loading="lazy" class="w-full h-auto" />
        ))}
      </div>
      <div class="flex gap-[var(--space-12)]">
        <a href="/files/cleaning.pdf" target="_blank" rel="noopener noreferrer" class="product-button">
          <P1 as="span">{t.cleaning}</P1>
        </a>
      </div>
    </div>
  )
}
