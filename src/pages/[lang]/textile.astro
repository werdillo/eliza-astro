---
import { Layout } from "#/app/layout";
import { textilePage, TextileItems } from "#/site/materials";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/textile" title={textilePage[lang].title} description={textilePage[lang].description}>
  <h1 class="sr-only">{textilePage[lang].h1}</h1>
  <TextileItems lang={lang} />
</Layout>
