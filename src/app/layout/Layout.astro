---
import { Header, Footer, MobileMenu } from "#/app/frame";
import { GoogleAnalytics } from "#/features/analytics";
import "#/app/styles/tokens.css";
import "#/app/styles/base.css";
import "#/app/styles/animations.css";
import SeoHead from "./SeoHead.astro";

export interface Props {
    offset?: boolean;
    title?: string;
    description?: string;
    keywords?: string;
    image?: string;
    url?: string;
    type?: string;
}

const { lang = "lv" } = Astro.params;
const { offset = true, type = "website", ...seo } = Astro.props as Props;
---

<html lang={lang}>
    <head>
        <SeoHead lang={lang} type={type} {...seo} />
        <GoogleAnalytics />
    </head>
    <body class="m-0 p-0 font-body">
        <div id="main" class="flex min-h-[100vh] flex-col">
            <Header />
            <article class:list={["mt-[var(--header-height)] max-768:mt-[var(--header-height-mobile)] flex flex-col items-center flex-1", offset && "px-[var(--space-12)]"]}>
                <slot />
            </article>
            <MobileMenu />
            <Footer lang={lang} />
        </div>
    </body>
</html>
