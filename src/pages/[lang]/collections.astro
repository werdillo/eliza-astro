---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { CollectionIndex } from "#/site/collections";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout offset={false} lang={lang} path="/collections" title={pages.collections[lang].title} description={pages.collections[lang].description}>
  <h1 class="sr-only">{pages.collections[lang].h1}</h1>
  <CollectionIndex lang={lang} />
</Layout>
