---
import type { ImageMetadata } from "astro";

export interface Props {
    image: ImageMetadata;
    title: string;
    text: string;
    button: string;
    href: string;
}

const { image, title, text, button, href } = Astro.props;
---

<div class="relative w-full h-[600px] max-768:h-[400px] max-480:h-[300px]">
    <div class="absolute top-0 left-0 w-full h-full bg-cover bg-center" style={`background-image: url(${image.src});`} />
    <div class="absolute top-0 left-0 w-full h-full flex items-center justify-start [background:linear-gradient(90deg,var(--color-scrim-50)_0%,var(--color-scrim-20)_50%,var(--color-clear)_100%)]">
        <div class="max-w-[700px] ml-[var(--space-70)] [padding:[0_var(--space-40)] text-white text-left max-768:ml-[var(--space-30)] max-768:[padding:[0_var(--space-20)]">
            <h1 class="font-avenir text-fs-72 font-light [letter-spacing:2px] [margin:[0_0_var(--space-20)_0] leading-[1.1] uppercase max-768:text-fs-36 max-768:[margin-bottom:[var(--space-16)] max-480:text-fs-28">{title}</h1>
            <p class="font-avenir text-fs-32 font-normal [margin:[0_0_var(--space-40)_0] leading-[1.4] [opacity:0.95] max-768:text-fs-16 max-768:[margin-bottom:[var(--space-30)] max-480:text-fs-14">{text}</p>
            <a href={href} class="inline-block font-avenir text-fs-16 font-semibold [letter-spacing:1px] uppercase [padding:[var(--space-16)_var(--space-40)] bg-white text-layout no-underline [border:2px_solid_var(--color-text)] [transition:all_0.3s_ease] hov:[background:transparent] hov:text-white max-768:text-fs-14 max-768:[padding:[var(--space-12)_var(--space-30)] max-480:[padding:[var(--space-12)_var(--space-20)]">{button}</a>
        </div>
    </div>
</div>
