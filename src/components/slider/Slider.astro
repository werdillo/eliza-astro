---
/**
 * A Swiper container. The slides are the children: each one is a `<swiper-slide>`.
 * Attributes are passed as strings, exactly as Swiper reads them.
 */
export interface Props {
  id?: string;
  class?: string;
  slidesPerView?: string;
  navigation?: string;
  pagination?: string;
  paginationType?: string;
  speed?: string;
  loop?: string;
  autoplayDelay?: string;
}

const { id, class: extra, slidesPerView, navigation, pagination, paginationType, speed, loop, autoplayDelay } = Astro.props;
---

<swiper-container
  id={id}
  class={extra}
  slides-per-view={slidesPerView}
  navigation={navigation}
  pagination={pagination}
  pagination-type={paginationType}
  speed={speed}
  loop={loop}
  autoplay-delay={autoplayDelay}
>
  <slot />
</swiper-container>

<script>
  import { register } from "swiper/element/bundle";
  register();
</script>
