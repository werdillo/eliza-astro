---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { CollectionGrid } from "#/catalog/collections";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const crumbs = [{ name: pages.collections[lang].h1 ?? "", path: "/collections" }, { name: pages.basic[lang].h1 ?? "", path: "/collection/basic" }];
---

<Layout lang={lang} crumbs={crumbs} path="/collection/basic" title={pages.basic[lang].title} description={pages.basic[lang].description}>
  <h1 class="sr-only">{pages.basic[lang].h1}</h1>
  <CollectionGrid brand="basic" lang={lang} />
</Layout>
