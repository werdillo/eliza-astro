---
import { Image } from "astro:assets";
import type { Language } from "#/features/i18n";
import { materialCards } from "./data";

export interface Props {
    lang?: Language;
}

const { lang = "lv" } = Astro.props;
---

<div class="my-[var(--space-20)] grid grid-cols-[1fr_1fr] gap-[var(--space-16)] w-full max-768:grid-cols-[1fr]">
    {
        materialCards(lang).map((card) => (
            <div>
                <a href={card.href} target={card.external ? "_blank" : undefined} rel="noopener noreferrer">
                    <Image class="w-full h-auto min-h-[200px] bg-photo [box-shadow:var(--shadow-photo)] [transition:var(--duration-base)] cursor-pointer hov:shadow-[var(--shadow-photo-hover)]" alt="" src={card.image} />
                </a>
                <div class="font-avenir font-bold text-fs-24 ml-[var(--space-4)] mb-[var(--space-4)] mt-[var(--space-16)]">{card.title}</div>
                <div class="font-avenir font-normal text-fs-16 ml-[var(--space-4)]">{card.text}</div>
            </div>
        ))
    }
</div>
