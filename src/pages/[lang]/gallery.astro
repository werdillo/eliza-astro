---
import { Layout } from "#/app/layout";
import { galleryPage, GalleryImages } from "#/site/company";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/gallery" title={galleryPage[lang].title} description={galleryPage[lang].description}>
  <h1 class="sr-only">{galleryPage[lang].h1}</h1>
  <GalleryImages />
</Layout>
