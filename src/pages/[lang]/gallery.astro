---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { GalleryImages } from "#/site/company";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/gallery" title={pages.gallery[lang].title} description={pages.gallery[lang].description}>
  <h1 class="sr-only">{pages.gallery[lang].h1}</h1>
  <GalleryImages />
</Layout>
