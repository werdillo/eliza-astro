---
// The 404 page. The server serves it for any unknown URL at any depth, so its links are root-absolute.
// It is not a language page: it has no address of its own (no canonical, alternates or schema) and is noindex.
import { Layout } from "#/app/layout";
import { H2, P1, P2 } from "#/components/typography";
import { LANGUAGES, type Language } from "#/features/i18n";
import { collectionsPage } from "#/site/collections";

const messages: Record<Language, { text: string; home: string }> = {
  lv: { text: "Meklētā lapa nav atrasta vai ir pārvietota.", home: "Sākumlapa" },
  en: { text: "The page you are looking for does not exist or has moved.", home: "Home" },
  ru: { text: "Страница, которую вы ищете, не существует или перемещена.", home: "Главная" },
};
---

<Layout lang="lv" title="Lapa nav atrasta - Eliza-K" description="Meklētā lapa nav atrasta. Atgriezieties Eliza-K sākumlapā vai apskatiet kolekcijas." noindex error>
  <div class="flex flex-col items-center gap-[2.5rem] py-[3rem] text-center">
    <H2 as="h1">404</H2>
    {
      LANGUAGES.map((lang) => (
        <section lang={lang} class="flex flex-col items-center gap-[1rem]">
          <P1>{messages[lang].text}</P1>
          <P2 class="flex flex-wrap justify-center gap-[1.5rem]">
            <a href={`/${lang}/`} class="underline">{messages[lang].home}</a>
            <a href={`/${lang}/collections/`} class="underline">{collectionsPage[lang].h1}</a>
          </P2>
        </section>
      ))
    }
  </div>
</Layout>
