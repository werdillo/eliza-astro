---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { SegmentsGrid } from "#/horeca/segments";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout offset={false} lang={lang} path="/horeca" title={pages.horeca[lang].title} description={pages.horeca[lang].description}>
  <h1 class="sr-only">{pages.horeca[lang].h1}</h1>
  <SegmentsGrid lang={lang} />
</Layout>
