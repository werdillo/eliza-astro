---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { MaterialsList } from "#/site/materials";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/components" title={pages.components[lang].title} description={pages.components[lang].description}>
  <h1 class="sr-only">{pages.components[lang].h1}</h1>
  <MaterialsList lang={lang} />
</Layout>
