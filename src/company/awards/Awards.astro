---
import { Slider } from "#/components/slider";

const awards = Array.from(
    { length: 13 },
    (_, index) => `award_${13 - index}.jpg`,
);
---

<div class="awards">
    <Slider
        id="awards-swiper"
        pagination="false"
        speed="500"
        loop="true"
        autoplayDelay="3000"
    >
        {
            awards.map((image) => (
                <swiper-slide>
                    <div class="-wrapper">
                        <img
                            src={`/awards/${image}`}
                            alt="Award certificate"
                            class="-img"
                            loading="lazy"
                        />
                    </div>
                </swiper-slide>
            ))
        }
    </Slider>
</div>

<script>
    // Configure breakpoints after DOM is ready
    document.addEventListener("DOMContentLoaded", () => {
        const swiperEl = document.querySelector<HTMLElement & { breakpoints?: unknown }>(
            "#awards-swiper",
        );
        if (swiperEl) {
            const breakpoints = {
                1400: { slidesPerView: 8, navigation: true },
                1200: { slidesPerView: 6, navigation: true },
                768: { slidesPerView: 4 },
                500: { slidesPerView: 3 },
                300: { slidesPerView: 3 },
            };

            Object.assign(swiperEl, {
                breakpoints: breakpoints,
            });
        }
    });
</script>
