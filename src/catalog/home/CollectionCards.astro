---
import { Image } from "astro:assets";
import { t, type Language } from "#/features/i18n";
import { H4 } from "#/components/typography";
import { collectionCards } from "./data";

export interface Props {
  lang?: Language;
}

const { lang = "lv" } = Astro.props;
---

<div class="mt-[var(--space-2)] mb-[var(--space-30)] grid gap-[var(--space-2)] grid-cols-[1fr_1fr_1fr] justify-center w-full max-1024:grid-cols-[1fr]">
  {
    collectionCards.map((card) => {
      const url = typeof card.url === "function" ? card.url(lang) : card.url;
      return (
        <a href={url} rel={card.external ? "noopener noreferrer" : undefined} target={card.external ? "_blank" : undefined} class="block">
          <div class="relative w-full h-auto aspect-[16/10] flex justify-center items-center overflow-hidden [box-shadow:var(--shadow-card)] group">
            <Image src={card.image} alt="" class="absolute top-0 left-0 w-full h-full object-cover object-center [filter:brightness(0.7)] z-[1] [transition:var(--duration-fast)] hov:[filter:brightness(0.6)]" />
            <H4 as="span" class="relative z-[2] text-white">{t(card.translationKey, lang)}</H4>
          </div>
        </a>
      );
    })
  }
</div>
