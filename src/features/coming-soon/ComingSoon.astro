---
import type { Language } from "#/features/i18n";
import { H2, P1, P2 } from "#/components/typography";
import background from "./assets/background.jpg";
import { comingSoonCopy } from "./data";

export interface Props {
  lang?: Language;
}

const { lang = "lv" } = Astro.props;
const copy = comingSoonCopy[lang];
---

<div class="relative h-[100vh] w-full">
  <img src={background.src} alt="" width={background.width} height={background.height} class="absolute top-0 left-0 w-full h-full object-cover object-center [filter:brightness(0.6)] z-[-1]" />

  <div class="flex flex-col items-center justify-center h-full text-white text-center p-[2rem]">
    <div class="bg-scrim-60 p-[2rem] rounded-[10px] max-w-[600px]">
      <H2 as="h1" class="mb-[1rem]">{copy.title}</H2>
      <P1 class="mb-[1.5rem]">{copy.message}</P1>
      <P1 class="mb-[1.5rem]">{copy.subMessage}</P1>

      <div class="flex gap-[1rem] mt-[1.5rem] justify-center">
        <a href={"/" + lang} class="[background:none] [border:2px_solid_var(--color-text)] text-white px-[1rem] py-[0.5rem] rounded-[var(--radius-tile)] cursor-pointer no-underline inline-block [transition:all_0.3s_ease] hov:[background-color:var(--color-text)] hov:text-black">
          <P2 as="span">{copy.button}</P2>
        </a>
      </div>
    </div>
  </div>
</div>
