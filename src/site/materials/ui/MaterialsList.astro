---
import { Image } from "astro:assets";
import type { Language } from "#/features/i18n";
import { H4, P2 } from "#/components/typography";
import { materialCards } from "../data";

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div class="my-[var(--space-20)] grid grid-cols-[1fr_1fr] gap-[var(--space-16)] w-full max-768:grid-cols-[1fr]">
  {
    materialCards(lang).map((card) => (
      <section>
        <a href={card.href} target={card.external ? "_blank" : undefined} rel="noopener noreferrer" class="block">
          <Image class="w-full h-auto min-h-[200px] bg-photo [box-shadow:var(--shadow-photo)] [transition:var(--duration-base)] cursor-pointer hov:shadow-[var(--shadow-photo-hover)]" alt={card.title} src={card.image} />
        </a>
        <H4 as="h2" class="ml-[var(--space-4)] mb-[var(--space-4)] mt-[var(--space-16)]">{card.title}</H4>
        <P2 class="ml-[var(--space-4)]">{card.text}</P2>
      </section>
    ))
  }
</div>
