---
// The old product URL, `/en/product?name=<path>`: sent on to `/en/product/<slug>/`.
import { Redirect } from "#/app/layout";
import { salePage, productRedirects } from "#/site/products";
import { LANGUAGES, type Language } from "#/features/i18n";

export async function getStaticPaths() {
  const map = await productRedirects("sale");
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { map } }));
}

const { lang } = Astro.params as { lang: Language };
const { map } = Astro.props;
---

<Redirect lang={lang} base={`/${lang}/sale-product/`} fallback={`/${lang}/sale/`} map={map} linkText={salePage[lang].h1 ?? ""} />
