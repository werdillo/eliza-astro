---
import { Layout } from "#/app/layout";
import { collectionsPage, CollectionIndex } from "#/site/collections";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout offset={false} lang={lang} path="/collections" title={collectionsPage[lang].title} description={collectionsPage[lang].description}>
  <h1 class="sr-only">{collectionsPage[lang].h1}</h1>
  <CollectionIndex lang={lang} />
</Layout>
