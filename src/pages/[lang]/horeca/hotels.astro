---
import { Layout } from "#/app/layout";
import { horecaPage, hotelsPage } from "#/site/segments";
import { LANGUAGES, type Language } from "#/features/i18n";
import { ComingSoon } from "#/features/coming-soon";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const crumbs = [{ name: horecaPage[lang].h1 ?? "", path: "/horeca" }, { name: hotelsPage[lang].h1 ?? "", path: "/horeca/hotels" }];
---

<Layout lang={lang} crumbs={crumbs} path="/horeca/hotels" title={hotelsPage[lang].title} description={hotelsPage[lang].description} offset={false}>
  <ComingSoon lang={lang} />
</Layout>
