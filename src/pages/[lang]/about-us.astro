---
import { Layout } from "#/app/layout";
import { AboutUs, aboutUsPage } from "#/site/company";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/about-us" title={aboutUsPage[lang].title} description={aboutUsPage[lang].description} offset={false}>
  <AboutUs lang={lang} />
</Layout>
