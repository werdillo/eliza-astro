---
// The old product URL, `/en/product?name=<path>`: sent on to `/en/product/<slug>/`.
import { Redirect, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { productRedirects } from "#/site/products";

export async function getStaticPaths() {
  const map = await productRedirects("mattress");
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { map } }));
}

const { lang } = Astro.params as { lang: Language };
const { map } = Astro.props;
---

<Redirect lang={lang} base={`/${lang}/mattress/`} fallback={`/${lang}/matresses/`} map={map} linkText={pages.mattresses[lang].h1 ?? ""} />
