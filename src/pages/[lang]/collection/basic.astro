---
import { Layout } from "#/app/layout";
import { collectionsPage, basicPage, CollectionGrid } from "#/site/collections";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const crumbs = [{ name: collectionsPage[lang].h1 ?? "", path: "/collections" }, { name: basicPage[lang].h1 ?? "", path: "/collection/basic" }];
---

<Layout lang={lang} crumbs={crumbs} path="/collection/basic" title={basicPage[lang].title} description={basicPage[lang].description}>
  <h1 class="sr-only">{basicPage[lang].h1}</h1>
  <CollectionGrid brand="basic" lang={lang} />
</Layout>
