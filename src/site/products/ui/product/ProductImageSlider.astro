---
import { Image } from "astro:assets";
import { fileUrl } from "#/core/pocketbase";
import type { Product, ProductKind } from "#/site/shared/product";
import { Slider } from "#/components/slider";

export interface Props {
  item: Product;
  kind: ProductKind;
}

const { item, kind } = Astro.props;
const images = item.images ?? [];
const single = kind === "mattress" ? item.image : images[0];
// Mattress and sale photos come in any proportion, many of them portrait, so they are shown whole; the other products keep the 16:9 crop.
const whole = kind === "mattress" || kind === "sale";
const imageClass = whole ? "product-slider-whole" : "product-slider";
// The slider is 65vw wide on desktop and full width below 1200px.
const photo = { width: 1600, height: whole ? 1600 : 900, fit: whole ? ("contain" as const) : ("cover" as const), widths: [640, 1024, 1600], sizes: "(max-width: 1200px) 100vw, 65vw", format: "webp" as const, quality: 80 };
---

{
  images.length > 1 ? (
    <Slider
      class="product-swiper"
      slidesPerView="1"
      navigation="true"
      pagination="true"
      paginationType="fraction"
      speed="500"
      loop="true"
      autoplayDelay="5000"
    >
      {images.map((image, index) => (
        <swiper-slide>
          <Image src={fileUrl(item, image)} alt={item.name} {...photo} class={imageClass} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : undefined} />
        </swiper-slide>
      ))}
    </Slider>
  ) : (
    <Image src={fileUrl(item, single)} alt={item.name} {...photo} class={imageClass} loading="eager" fetchpriority="high" />
  )
}
