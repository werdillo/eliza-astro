---
import { Layout, pageUrl } from "#/app/layout";
import { collectionsPage } from "#/site/collections";
import { productPage, ProductPage, PRODUCT_SECTION, productImage, productMeta, productPages, productSchema } from "#/site/products";
import type { Language } from "#/features/i18n";

export async function getStaticPaths() {
  return productPages("def");
}

const { item, kind, lang } = Astro.props;
const path = `/${PRODUCT_SECTION[kind]}/${item.slug}`;
const image = productImage(item, kind, lang);
const meta = productMeta(item, kind, lang, productPage[lang as Language].description);
const crumbs = [
  { name: collectionsPage[lang as Language].h1 ?? "", path: "/collections" },
  { name: item.name, path },
];
---

<Layout lang={lang} path={path} title={meta.title} description={meta.description} image={image} type="product" offset={false} crumbs={crumbs} nodes={[productSchema({ item, kind, lang, url: pageUrl(lang, path), image, description: meta.description })]}>
  <ProductPage item={item} kind={kind} lang={lang} />
</Layout>
