---
import { fileUrl } from "#/core/pocketbase";
import { productLink } from "../../routes";
import type { Product } from "#/site/shared/product";
import { typeLabel } from "#/site/shared/typeLabels";
import type { Language } from "#/features/i18n";
import { LandingTile } from "#/components/landing-tile";
import { H3, H5, P2, P3 } from "#/components/typography";
import { getSaleItems } from "../../api";
import SaleNav from "./SaleNav.astro";

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const items = await getSaleItems();

/** The visible items grouped by type, each group in the order of its `index`. */
const groups = new Map<string, Product[]>();
for (const item of items) {
  const key = item.types || item.type || "other";
  groups.set(key, [...(groups.get(key) ?? []), item]);
}
for (const group of groups.values()) group.sort((a, b) => (a.index || 0) - (b.index || 0));

/** Each group's anchor in the URL, e.g. `#sofa`. */
const taken = new Set(["all"]);
const sections = [...groups].map(([type, group], i) => {
  const base = type.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "group";
  const slug = taken.has(base) ? `${base}-${i}` : base;
  taken.add(slug);
  return { type, group, slug, label: typeLabel(lang, type) };
});

const cards = new Map<string, string>();
for (const item of items) cards.set(item.id, await productLink(lang, "sale", item.id));
---

<SaleNav lang={lang} groups={sections.map(({ slug, label, group }) => ({ slug, label, count: group.length }))}>
  {
    sections.map(({ group, slug, label }) => (
      <section id={slug} class="sale-nav-section" data-sale-group>
        <H3 as="h2" class="list-title">{label}</H3>
        <div class="product-list">
          {group.map((item) => (
            <LandingTile href={cards.get(item.id) ?? "#"} src={fileUrl(item, item.images[0])} alt={item.name}>
              {item.price ? (
                <div class="sale-row flex justify-between items-center mt-[4px] gap-[12px] p-[2px]">
                  <P2 as="p" class="sale-name">{item.name.toUpperCase()}</P2>
                  <div class="landing-price-row m-0 shrink-0">
                    {item.oldPrice && <P3 as="span" class="landing-old-price">€{item.oldPrice}</P3>}
                    <H5 as="span" class="landing-price">€{item.price}</H5>
                  </div>
                </div>
              ) : (
                <P2 as="p" class="landing-name">{item.name.toUpperCase()}</P2>
              )}
            </LandingTile>
          ))}
        </div>
      </section>
    ))
  }
</SaleNav>
