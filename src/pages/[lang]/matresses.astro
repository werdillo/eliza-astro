---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { MatGrid } from "#/catalog/mattresses";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/matresses" title={pages.mattresses[lang].title} description={pages.mattresses[lang].description}>
  <h1 class="sr-only">{pages.mattresses[lang].h1}</h1>
  <MatGrid lang={lang} />
</Layout>
