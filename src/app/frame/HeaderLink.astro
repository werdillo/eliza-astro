---
export interface Props {
  href: string;
  label: string;
  active: boolean;
  sale?: boolean;
  external?: boolean;
}

const { href, label, active, sale = false, external = false } = Astro.props;

// The sale link keeps its own colours whatever its state, as the old rule did with !important.
const colour = sale ? "text-white" : active ? "text-accent" : "text-white hov:text-accent";
const skin = sale ? (active ? "header-sale-live" : "header-sale") : "";
---

<a href={href} class:list={["header-link text-p3", colour, skin]} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{label}</a>
