---
import { Image } from "astro:assets";
import type { Language } from "#/features/i18n";
import { catalogCopy, catalogs } from "./data";

export interface Props {
    lang?: Language;
}

const { lang = "lv" } = Astro.props;
const copy = catalogCopy[lang] ?? catalogCopy.lv;
---

<div class="catalogs-title">{copy.pageTitle}</div>

<div class="catalogs">
    {
        catalogs.map((catalog) => (
            <div class="catalog">
                <a href={catalog.file} class="catalog-link" target="_blank" rel="noopener noreferrer">
                    <Image src={catalog.image} alt={catalog.alt} class="catalog-img" />
                </a>
                <span class="catalog-label">{`${copy.catalog} ${catalog.year}`}</span>
            </div>
        ))
    }
</div>
