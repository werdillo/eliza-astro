---
import { Image } from "astro:assets";
import type { Language } from "#/features/i18n";
import { H4 } from "#/components/typography";
import { translations } from "../../data";
import falcone from "../../assets/fabrics/falcone.jpeg";
import matrix from "../../assets/fabrics/matrix.jpeg";
import salvador from "../../assets/fabrics/salvador.jpeg";

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = translations[lang];
const fabrics = [
  { src: matrix, alt: "Matrix" },
  { src: falcone, alt: "Falcone" },
  { src: salvador, alt: "Salvador" },
];
---

<section class="flex flex-col gap-[var(--space-12)]">
  <H4 as="h2" class="m-0">{t.fabrics}</H4>
  <div class="prod-fabrics">
    {fabrics.map((fabric) => <Image src={fabric.src} alt={fabric.alt} width={320} format="webp" quality={78} class="block w-full h-auto" />)}
  </div>
</section>
