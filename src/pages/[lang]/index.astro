---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { Awards } from "#/company/awards";
import { CollectionCards, HomeHero } from "#/catalog/home";

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout offset={false} lang={lang} title={pages.home[lang].title} description={pages.home[lang].description}>
  <HomeHero lang={lang} />
  <CollectionCards lang={lang} />
  <Awards />
</Layout>
