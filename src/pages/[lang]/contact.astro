---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { Contacts } from "#/company/contacts";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/contact" title={pages.contact[lang].title} description={pages.contact[lang].description}>
  <h1 class="sr-only">{pages.contact[lang].h1}</h1>
  <Contacts lang={lang} />
</Layout>
