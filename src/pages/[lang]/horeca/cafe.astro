---
import { Layout } from "#/app/layout";
import { horecaPage, cafePage } from "#/site/segments";
import { LANGUAGES, type Language } from "#/features/i18n";
import { ComingSoon } from "#/features/coming-soon";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const crumbs = [{ name: horecaPage[lang].h1 ?? "", path: "/horeca" }, { name: cafePage[lang].h1 ?? "", path: "/horeca/cafe" }];
---

<Layout noindex lang={lang} crumbs={crumbs} path="/horeca/cafe" title={cafePage[lang].title} description={cafePage[lang].description} offset={false}>
  <ComingSoon lang={lang} />
</Layout>
