---
import { Layout } from "#/app/layout";
import { contactPage, Contacts } from "#/site/company";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/contact" title={contactPage[lang].title} description={contactPage[lang].description}>
  <h1 class="sr-only">{contactPage[lang].h1}</h1>
  <Contacts lang={lang} />
</Layout>
