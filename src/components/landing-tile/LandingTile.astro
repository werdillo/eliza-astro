---
import { Image } from "astro:assets";

/** A picture on a light card with its caption below, linking somewhere. */
export interface Props {
  href: string;
  src: string;
  alt: string;
}

const { href, src, alt } = Astro.props;
---

<a href={href} class="block no-underline">
  <div class="landing">
    <Image src={src} alt={alt} width={1200} height={675} fit="cover" position="top" widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 25vw" format="webp" quality={78} class="landing-img" />
    <slot />
  </div>
</a>
