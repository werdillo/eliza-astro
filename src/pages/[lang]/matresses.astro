---
import { Layout } from "#/app/layout";
import { mattressesPage, MatGrid } from "#/site/products";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/matresses" title={mattressesPage[lang].title} description={mattressesPage[lang].description}>
  <h1 class="sr-only">{mattressesPage[lang].h1}</h1>
  <MatGrid lang={lang} />
</Layout>
