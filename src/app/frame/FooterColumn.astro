---
import type { ContactPoint } from "#/site/company";
import { H4, P2 } from "#/components/typography";

export interface Props {
  title: string;
  contact: ContactPoint;
}

const { title, contact } = Astro.props;
---

<section>
  <H4 as="h2" class="mb-[1rem]">{title}</H4>
  {
    contact.address && (
      <P2 class="my-[0.5rem]">
        <a href={`https://maps.google.com/?q=${contact.address}`} target="_blank" rel="noopener noreferrer" class="footer-link">
          {contact.address}
        </a>
      </P2>
    )
  }
  <P2 class="my-[0.5rem]">
    <a href={`mailto:${contact.mail}`} class="footer-link">{contact.mail}</a>
  </P2>
  <P2 class="my-[0.5rem]">
    {
      contact.phone.map((phone, index) => (
        <>
          {index > 0 ? ", " : null}
          <a href={`tel:+371${phone}`} class="footer-link">{phone}</a>
        </>
      ))
    }
  </P2>
</section>
