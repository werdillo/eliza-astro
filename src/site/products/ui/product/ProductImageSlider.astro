---
import { fileUrl } from "#/core/pocketbase";
import type { Product, ProductKind } from "#/site/shared/product";
import { Slider } from "#/components/slider";

export interface Props {
  item: Product;
  kind: ProductKind;
}

const { item, kind } = Astro.props;
const images = item.images ?? [];
const single = kind === "mattress" ? item.image : images[0];
---

{
  images.length > 1 ? (
    <Slider
      class="product-swiper"
      slidesPerView="1"
      navigation="true"
      pagination="true"
      paginationType="fraction"
      speed="500"
      loop="true"
      autoplayDelay="5000"
    >
      {images.map((image, index) => (
        <swiper-slide>
          <img src={fileUrl(item, image)} alt={item.name} width="1600" height="900" class="product-slider" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : undefined} />
        </swiper-slide>
      ))}
    </Slider>
  ) : (
    <img src={fileUrl(item, single)} alt={item.name} width="1600" height="900" class="product-slider" fetchpriority="high" />
  )
}
