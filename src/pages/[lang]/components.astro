---
import { Layout } from "#/app/layout";
import { componentsPage, MaterialsList } from "#/site/materials";
import { LANGUAGES, type Language } from "#/features/i18n";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/components" title={componentsPage[lang].title} description={componentsPage[lang].description}>
  <h1 class="sr-only">{componentsPage[lang].h1}</h1>
  <MaterialsList lang={lang} />
</Layout>
