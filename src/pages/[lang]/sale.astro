---
import { Layout, pages } from "#/app/layout";
import { LANGUAGES, type Language } from "#/features/i18n";
import { SaleGrid } from "#/site/products";
export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Layout lang={lang} path="/sale" title={pages.sale[lang].title} description={pages.sale[lang].description}>
  <h1 class="sr-only">{pages.sale[lang].h1}</h1>
  <SaleGrid lang={lang} />
</Layout>
